# vault.hcl — Generated by UDAP Ansible role
# HashiCorp Vault configuration for {{ project_name }}
# Node: {{ vault_instance_id }} / {{ vault_node_ip }}

# ---------------------------------------------------------------------------
# Core settings
# ---------------------------------------------------------------------------

cluster_name = "{{ project_name }}-vault-cluster"

ui            = true
log_level     = "info"
log_format    = "json"
disable_mlock = false   # IPC_LOCK is set on the binary

api_addr     = "http://{{ vault_node_ip }}:{{ vault_port_api }}"
cluster_addr = "https://{{ vault_node_ip }}:{{ vault_port_cluster }}"

# ---------------------------------------------------------------------------
# HTTP Listener — port 8200
# ALB handles external access; Vault listens plain HTTP inside the VPC.
# Cluster port 8201 stays HTTPS for inter-node Raft/HA communication.
# ---------------------------------------------------------------------------

listener "tcp" {
  address     = "0.0.0.0:{{ vault_port_api }}"
  tls_disable = true

  # Trust ALB forwarded-for headers
  x_forwarded_for_authorized_addrs = "10.0.0.0/16"
}

# ---------------------------------------------------------------------------
# Storage Backend — S3
# ---------------------------------------------------------------------------

storage "s3" {
  region = "{{ vault_aws_region }}"
  bucket = "{{ vault_s3_bucket }}"
  path   = "vault/"

  # HA is coordinated separately via DynamoDB (ha_storage below)
  disable_clustering = "false"
}

# ---------------------------------------------------------------------------
# HA Storage — DynamoDB (leader election + session tokens)
# ---------------------------------------------------------------------------

ha_storage "dynamodb" {
  region     = "{{ vault_aws_region }}"
  table      = "{{ vault_dynamo_table }}"
  ha_enabled = "true"

  # Read/write capacity is managed by the table (PAY_PER_REQUEST)
}

# ---------------------------------------------------------------------------
# Seal — AWS KMS auto-unseal
# ---------------------------------------------------------------------------

seal "awskms" {
  region     = "{{ vault_aws_region }}"
  kms_key_id = "{{ vault_kms_key_id }}"
}

# ---------------------------------------------------------------------------
# Telemetry — CloudWatch / Prometheus compatible metrics
# ---------------------------------------------------------------------------

telemetry {
  prometheus_retention_time = "30s"
  disable_hostname          = false
  enable_hostname_label      = true
}
